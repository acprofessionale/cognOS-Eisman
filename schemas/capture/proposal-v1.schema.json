{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognos-eisman/capture-proposal/v1",
  "title": "CognOS-Eisman Capture Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "normative_scope",
    "proposal_id",
    "proposal_state",
    "review_state",
    "publication_class",
    "created_at_utc",
    "assertion_mode",
    "proposal_type",
    "confidence",
    "text",
    "source_capture",
    "canonical_entity_ref"
  ],
  "properties": {
    "schema_id": {"const": "cognos-eisman/capture-proposal/v1"},
    "schema_version": {"const": 1},
    "normative_scope": {"const": "VERTICAL_EISMAN_PROVISIONAL"},
    "proposal_id": {"type": "string", "pattern": "^prop_[0-9a-f]{32}$"},
    "proposal_state": {"const": "PROPOSED"},
    "review_state": {"const": "PENDING"},
    "publication_class": {"const": "DENY"},
    "created_at_utc": {"type": "string"},
    "assertion_mode": {"enum": ["HUMAN_ASSERTED", "AI_PROPOSED", "AI_EXTRACTED"]},
    "proposal_type": {"enum": ["OBSERVATION", "CLAIM", "RELATION", "ENTITY_CANDIDATE"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "text": {"type": "string", "minLength": 1},
    "source_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_id", "sha256", "receipt_ref"],
      "properties": {
        "capture_id": {"type": "string", "pattern": "^cap_[0-9a-f]{32}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "receipt_ref": {"type": "string", "pattern": "^inbox/cap_[0-9a-f]{32}\\.json$"}
      }
    },
    "canonical_entity_ref": {"type": ["string", "null"]}
  }
}
