{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognos.local/schemas/eisman/raw-capture.v1.schema.json",
  "title": "CognOS-Eisman Raw Capture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "normative_scope",
    "capture_id",
    "capture_state",
    "publication_class",
    "captured_at_utc",
    "source",
    "content",
    "raw_note",
    "derived_assertions"
  ],
  "properties": {
    "schema_id": {"const": "cognos-eisman/raw-capture/v1"},
    "schema_version": {"const": 1},
    "normative_scope": {"const": "VERTICAL_EISMAN_PROVISIONAL"},
    "capture_id": {"type": "string", "pattern": "^cap_[0-9a-f]{32}$"},
    "capture_state": {"const": "INBOX"},
    "publication_class": {"const": "DENY"},
    "captured_at_utc": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "original_filename", "source_modified_at_utc", "size_bytes", "media_type"],
      "properties": {
        "kind": {"const": "LOCAL_FILE"},
        "original_filename": {"type": "string", "minLength": 1},
        "source_modified_at_utc": {"type": "string", "format": "date-time"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest_algorithm", "sha256", "object_ref"],
      "properties": {
        "digest_algorithm": {"const": "sha256"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "object_ref": {"type": "string", "minLength": 1}
      }
    },
    "raw_note": {"type": ["string", "null"]},
    "derived_assertions": {
      "type": "array",
      "maxItems": 0
    }
  }
}
